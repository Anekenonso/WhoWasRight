# ==============================================================================
# WhoWasRight — Environment Configuration (.env)
# ==============================================================================

# Database (Supabase PostgreSQL - server only)
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server Session Security (32+ random characters)
SESSION_SECRET=

# Telegram Bot Authentication & Webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Walrus Memory Mainnet Integration
MEMWAL_KEY=# Ed25519 delegate private key (hex string or suiprivkey1...)
MEMWAL_ACCOUNT_ID=# Onchain MemWalAccount shared object ID on Sui Mainnet
MEMWAL_SERVER_URL=
MEMWAL_NAMESPACE_PREFIX=

# Application-Side Confidentiality (32 random bytes in hex: 64 hex characters)
MEMORY_ENCRYPTION_KEY=

# Tatum Blockchain Gateway (Sui Mainnet)
TATUM_API_KEY=
TATUM_SUI_GATEWAY_URL=
TATUM_SUI_GRPC_ENDPOINT=

# Football Data Provider (Automated Settlement)
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=

# Cron & Scheduler Secret
CRON_SECRET=

# Interactive Judge Demo Mode (Isolated Sandbox)
DEMO_SESSION_SECRET=
DEMO_SESSION_TTL_MINUTES=

# Application URL
APP_BASE_URL=

